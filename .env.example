# =============================================================================
# t2ai - AI Provider Configuration
# Copy this file to .env.local and fill in your values.
# =============================================================================

# -- Provider Selection -------------------------------------------------------
# Supported values: "ollama" | "fixture" | "gemini"
# Defaults to "ollama". Cloud providers are never selected as silent fallback.
AI_PROVIDER=ollama

# -- Ollama (free, local or private-network Mac mini) -------------------------
# Server-side only. Do not expose this to the browser.
# Same machine:
OLLAMA_BASE_URL=http://localhost:11434/v1
#
# Mac mini data plane example:
# OLLAMA_BASE_URL=http://mac-mini.local:11434/v1
#
# Recommended for Mac mini M2 Pro / 16 GB RAM:
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_STRUCTURED_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=30000
#
# Leave this off unless you intentionally proxy Ollama behind auth/TLS.
# OLLAMA_ALLOW_PUBLIC_URL=false

# -- Supabase persistence/auth -----------------------------------------------
# Leave blank for no-key demo mode with in-memory state.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# API persistence uses the user's Supabase access token plus RLS.
# No service-role key is needed for app reads/writes.
# Set to true after login UI exists and unauthenticated demo fallback should be disabled.
AUTH_REQUIRED=false
DEMO_USER_ID=demo-user
DEMO_USER_EMAIL=demo@fitloop.app

# -- RAG / Knowledge retrieval ------------------------------------------------
# Set to true to enable pgvector-backed knowledge retrieval.
# Requires Supabase with pgvector extension and seeded knowledge_chunks table.
# Run: npx tsx scripts/seed-knowledge.ts  (after running the 0003 migration)
KNOWLEDGE_RAG_ENABLED=false
# Embedding model for Ollama (default: nomic-embed-text, 384 dimensions)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Set to true for verbose RAG debug logging (shows retrieved chunks + scores)
# KNOWLEDGE_RAG_DEBUG=false

# -- Fixture mode -------------------------------------------------------------
# For UI development and tests with no model and no API keys.
# AI_PROVIDER=fixture

# -- Google Gemini ------------------------------------------------------------
# Explicit cloud mode for hackathons/free keys.
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
